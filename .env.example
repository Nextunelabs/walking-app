# Copy this file to .env.local and replace every placeholder.
# Never commit real database passwords, session secrets, or admin passwords.

# Neon PostgreSQL connection string for the WalkingApp database only.
# Do not point this at the VMS visitor database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/walkingapp?sslmode=require

# Random string, at least 16 characters. Example: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Walking sessions can last several hours, so the default is 12 hours.
SESSION_MAX_AGE_SECONDS=43200

# Used only by `npm run db:seed`. Not read by the web application at runtime.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FULL_NAME=Administrator
ADMIN_MOBILE=

# Public site URL. Use https:// in any deployed environment.
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Local testing only. Leave false in production.
# Shows a button that feeds simulated GPS steps through the same filters as a real device.
NEXT_PUBLIC_GPS_SIMULATION=false
